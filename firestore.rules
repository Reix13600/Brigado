rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // managers/{uid} -> { restaurantId, email }
    // A lookup table: does this signed-in uid manage this restaurant?
    // Only readable by the manager's own doc (no directory browsing) and
    // never writable from the client — managers are added via the Admin
    // SDK seed script, not through the app.
    //
    // Deliberately NOT gated on subscriptionStatus: TrialExpiredScreen
    // reads this doc (isAuthorizedManager) to verify the signed-in user
    // before opening the Stripe billing portal. Blocking it here would
    // break the only path an expired tenant has to pay and come back,
    // while protecting nothing — the doc holds no tenant data, and a uid
    // can only ever read its own.
    match /managers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Platform admin registry and the bonus-code system are FULLY closed
    // to client access — no reads, no writes, ever. Everything that
    // touches them goes through admin-checked callable functions using
    // the Admin SDK, which bypasses these rules.
    //
    // Locking reads matters as much as writes here: platformAdmins would
    // otherwise be an enumerable list of privileged accounts, and
    // bonusCodes would let anyone read unredeemed codes straight out of
    // the database and claim free accounts.
    match /platformAdmins/{email} {
      allow read, write: if false;
    }
    match /bonusCodes/{code} {
      allow read, write: if false;
      match /redemptions/{slug} {
        allow read, write: if false;
      }
    }

    function isManagerOf(restaurantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/managers/$(request.auth.uid))
        && get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.restaurantId == restaurantId;
    }

    // Any signed-in visitor (including anonymous staff sessions) can read
    // the app's data — this is a small single-location staff tool, not a
    // multi-tenant SaaS with per-user secrecy. Writes are the boundary.
    function isSignedIn() {
      return request.auth != null;
    }

    // Server-side mirror of the App.tsx trial-expiry gate. Until this
    // existed, blocking was UI-only: anyone with the slug and an
    // anonymous session could still read and write a blocked tenant's
    // data straight through the SDK.
    //
    // Reads subscriptionStatus off the PARENT restaurant doc, which is
    // written only by the Stripe webhook (Admin SDK — rules do not apply
    // to it, so reactivation and the day-30 purge are unaffected).
    //
    // `.get('subscriptionStatus', '')` defaults a MISSING field to
    // not-blocked on purpose: tenants provisioned before the field
    // existed must keep working exactly as before.
    //
    // Two statuses block, for different reasons:
    //   "trial_expired" — 30-day retention, then auto-purged
    //   "paused"        — admin-paused, no countdown, indefinite
    // Both use the SAME condition so there is exactly one access
    // boundary to reason about; only the on-screen copy differs.
    //
    // "comped" (bonus-code) tenants are deliberately NOT in this list:
    // they have full access, exactly like "active". When a comped period
    // runs out the scheduled job flips them to "trial_expired", and that
    // is what blocks them — the comped status itself never does.
    //
    // ⚠️ MIRRORED in src/utils/tenantStatus.ts's BLOCKING_STATUSES.
    // Rules cannot import that file, so this list is kept in sync BY
    // HAND — if you add a status to one, add it to the other. This
    // duplication is exactly what caused a real bug (see that file's own
    // comment): add a status here without also updating the client-side
    // list, and a blocked tenant's data fetch throws instead of showing
    // the right screen.
    function tenantBlocked(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId))
               .data.get('subscriptionStatus', '') in ['trial_expired', 'paused'];
    }

    match /restaurants/{restaurantId} {
      // The tenant doc itself stays READABLE while blocked — this is the
      // doc App.tsx fetches and live-watches to discover it is blocked in
      // the first place. Denying it would replace the explanatory block
      // screen with a generic connection error and strand the customer.
      allow read: if isSignedIn();
      // config/staff/dayNotes/weekNotes live on this doc — manager-only,
      // and frozen entirely once the tenant is blocked.
      allow create, delete: if isManagerOf(restaurantId) && !tenantBlocked(restaurantId);
      allow update: if !tenantBlocked(restaurantId) && (
        isManagerOf(restaurantId) ||
        // Activity heartbeat (lastActiveAt). Staff run on anonymous auth
        // and cannot write this doc, so without this they would never
        // register as activity — yet "a staff member clocked in" is the
        // strongest possible signal that a restaurant is alive.
        // isSignedIn() matters here even though anonymous sessions pass
        // it trivially: without it, a completely unauthenticated client
        // (no Firebase Auth session at all) could still write this field.
        // hasOnly() pins it to that one field: a signed-in-but-not-manager
        // session still cannot touch config, staff, PINs or billing.
        //
        // KNOWN QUIRK, not a hole: diff() compares VALUES, not which keys
        // the update() call named. update(ref, {staff: currentStaffValue})
        // — writing a field back to the value it already has — produces
        // an EMPTY affectedKeys() set, which vacuously satisfies hasOnly().
        // A non-manager can therefore "successfully" call update() with
        // other fields present, as long as every one of them is already
        // equal to what they're setting it to. This changes nothing about
        // the document (the write is a real no-op) and discloses nothing
        // (the caller must already know the current value to trigger it),
        // so it is not a security issue — documented here so it is not
        // mistaken for one and "fixed" into something more complicated.
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt']))
      );

      match /entries/{entryId} {
        allow read: if isSignedIn() && !tenantBlocked(restaurantId);
        // Staff can log their own hours (new doc, status must start
        // pending/correction — never self-approve) or edit their own
        // pending/correction rows. Managers can do anything, including
        // approvals.
        allow create: if isSignedIn() && !tenantBlocked(restaurantId) && (
          isManagerOf(restaurantId) ||
          (request.resource.data.status in ['pending', 'correction'])
        );
        allow update: if !tenantBlocked(restaurantId) && (
          isManagerOf(restaurantId) || (
            isSignedIn() &&
            resource.data.status in ['pending', 'correction'] &&
            request.resource.data.name == resource.data.name
          )
        );
        allow delete: if isManagerOf(restaurantId) && !tenantBlocked(restaurantId);
      }

      match /advances/{advanceId} {
        allow read: if isSignedIn() && !tenantBlocked(restaurantId);
        allow write: if isManagerOf(restaurantId) && !tenantBlocked(restaurantId);
      }

      match /scheduledShifts/{shiftId} {
        allow read: if isSignedIn() && !tenantBlocked(restaurantId);
        allow write: if isManagerOf(restaurantId) && !tenantBlocked(restaurantId);
      }

      // Live clock-in state. Same trust model as `entries`: identity is
      // enforced by the in-app PIN, not by Firebase Auth (staff sessions
      // are anonymous), so any signed-in visitor may write here — the app
      // itself only lets a PIN-unlocked staff member act as themselves.
      match /activeClockIns/{staffName} {
        allow read: if isSignedIn() && !tenantBlocked(restaurantId);
        allow write: if isSignedIn() && !tenantBlocked(restaurantId);
      }

      // Phase 3: messaging, time-off requests, open cover-swap requests.
      // Same trust model as above throughout.
      match /announcements/{id} {
        allow read: if isSignedIn() && !tenantBlocked(restaurantId);
        allow write: if isManagerOf(restaurantId) && !tenantBlocked(restaurantId);
      }
      match /messages/{id} {
        allow read: if isSignedIn() && !tenantBlocked(restaurantId);
        allow write: if isSignedIn() && !tenantBlocked(restaurantId);
      }
      match /timeOffRequests/{id} {
        allow read: if isSignedIn() && !tenantBlocked(restaurantId);
        allow write: if isSignedIn() && !tenantBlocked(restaurantId);
      }
      match /swapRequests/{id} {
        allow read: if isSignedIn() && !tenantBlocked(restaurantId);
        allow write: if isSignedIn() && !tenantBlocked(restaurantId);
      }

      // Phase B (variance approvals): manager-only for READ as well as
      // write, unlike every other subcollection above. Staff have no
      // reason to see whether a manager has signed off on a given day's
      // scheduled-vs-actual delta, so this deliberately does not follow
      // the "any signed-in visitor can read" default.
      match /varianceApprovals/{id} {
        allow read, write: if isManagerOf(restaurantId) && !tenantBlocked(restaurantId);
      }

      // Phase D (shift templates): manager-only for READ as well as
      // write, same rationale and precedent as varianceApprovals above —
      // staff have no legitimate reason to see or touch a manager's saved
      // shift shortcuts.
      match /shiftTemplates/{id} {
        allow read, write: if isManagerOf(restaurantId) && !tenantBlocked(restaurantId);
      }
    }
  }
}
